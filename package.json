{
  "name": "orca-dbml",
  "version": "1.1.0",
  "private": true,
  "description": "DBML language support and live ER diagrams for the Orca IDE.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:orca": "orca plugin types . && tsc --noEmit -p test/orca && orca plugin test .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "orca plugin validate .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && node scripts/build.mjs --verify"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@dbml/parse": "12.0.0",
    "@lezer/highlight": "^1.2.5",
    "lucide-preact": "^1.71.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
